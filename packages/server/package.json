{
  "name": "@vertskim/server",
  "version": "0.1.0",
  "description": "Vertskim local HTTP server: graph API, live events and the visualizer's static files",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "knowledge-graph",
    "code-graph",
    "code-search",
    "ai-assistant"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@vertskim/core": "0.1.0"
  },
  "devDependencies": {
    "@vertskim/ui": "0.1.0"
  }
}
